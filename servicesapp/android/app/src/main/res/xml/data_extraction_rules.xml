<?xml version="1.0" encoding="utf-8"?>
<!-- AUD-27 (auditoria 13/11): a sessão do Supabase fica nas preferências da
     app; não vai para o backup na nuvem nem para outro telemóvel. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
